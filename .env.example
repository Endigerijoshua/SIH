# ---------- NASA FIRMS (fire/thermal hotspot source) ----------
# REQUIRED. Get a free map key from https://firms.modaps.eosdis.nasa.gov/
FIRMS_MAP_KEY=replace-with-your-nasa-firms-map-key
# FIRMS area API dataset names: VIIRS_SNPP_NRT | MODIS_NRT | VIIRS_NOAA20_NRT | VIIRS_NOAA21_NRT
FIRMS_DATASET=VIIRS_SNPP_NRT
# India bounding box (west,south,east,north)
FIRMS_BBOX=68,6,97,37
# Day lookback window for firms area API (3 = last 72h; a quiet 24h period
# otherwise makes the demo look broken)
FIRMS_DAYS=3

# ---------- India boundary filter ----------
# Outward buffer (degrees) around the India polygon to absorb FIRMS point
# geolocation error (~375 m for VIIRS). 0.0 = strict polygon (recommended for
# demo integrity). Only raise if genuine border fires are being dropped.
INDIA_BOUNDARY_BUFFER_DEG=0.0

# ---------- Geo-spatial rules ----------
# Distance (meters) from an industrial/power-plant/mine zone that marks a fire.
BUFFER_METERS=1000

# ---------- Storage ----------
# SQLite database file (anchored to repo root) that accumulates every detection.
FIRE_HISTORY_DB=fire_history.db

# ---------- State bboxes (industrial/vegetation/mining Overpass tiles) ----------
# Mapping of state name -> "west,south,east,north" bbox (JSON object). Override
# only if you need to change which OSM regions Overpass queries.
# INDUSTRIAL_STATES={"gujarat": "67.5,20,75,25", "jharkhand": "83,21.5,88,25.5", ...}

# ---------- Persistence (persistent thermal source) ----------
# Radius (m) within which repeated detections coalesce; min distinct days to
# flag; lookback window (days).
PERSISTENCE_RADIUS_M=300
PERSISTENCE_MIN_OCCURRENCES=2
PERSISTENCE_LOOKBACK_DAYS=14

# ---------- Clustering (DBSCAN stretch) ----------
CLUSTERING_EPS_M=500
CLUSTERING_MIN_SAMPLES=2

# ---------- Overpass / cache tuning ----------
# HTTP timeout (s) for each Overpass request.
OVERPASS_TIMEOUT=180
# Cache file names + max age (hours) before a cached layer is re-fetched.
INDUSTRIAL_CACHE_FILE=industrial_zones_cache.json
VEGETATION_CACHE_FILE=vegetation_zones_cache.json
MINING_CACHE_FILE=mining_zones_cache.json
INDUSTRIAL_CACHE_MAX_AGE_HOURS=720
POWER_PLANTS_CACHE_FILE=power_plants_cache.json
POWER_PLANTS_CACHE_MAX_AGE_HOURS=720
FLARES_CACHE_FILE=flares_cache.json
FLARES_CACHE_MAX_AGE_HOURS=720