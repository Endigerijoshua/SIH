FIRMS_MAP_KEY=replace-with-your-nasa-firms-map-key
# FIRMS area API dataset names: VIIRS_SNPP_NRT | MODIS_NRT | VIIRS_NOAA20_NRT | VIIRS_NOAA21_NRT
FIRMS_DATASET=VIIRS_SNPP_NRT
# India bounding box (minLon,minLat,maxLon,maxLat)
FIRMS_BBOX=68,7,97,37
# Day lookback window for firms area API (1 = last 24h)
FIRMS_DAYS=1